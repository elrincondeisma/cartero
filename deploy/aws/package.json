{
  "name": "@cartero/deploy-aws",
  "version": "0.1.0",
  "private": true,
  "description": "Asistente para desplegar Cartero en AWS con CDK (Fargate o EC2, reutilizando lo que ya tengas)",
  "type": "module",
  "bin": {
    "cartero-aws": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "synth": "cdk synth"
  },
  "dependencies": {
    "@aws-sdk/client-acm": "^3.1175.0",
    "@aws-sdk/client-cloudformation": "^3.1175.0",
    "@aws-sdk/client-ec2": "^3.1175.0",
    "@aws-sdk/client-ecs": "^3.1175.0",
    "@aws-sdk/client-elasticache": "^3.1175.0",
    "@aws-sdk/client-rds": "^3.1175.0",
    "@aws-sdk/client-route-53": "^3.1175.0",
    "@aws-sdk/client-secrets-manager": "^3.1175.0",
    "@aws-sdk/client-service-quotas": "^3.1175.0",
    "@aws-sdk/client-ssm": "^3.1175.0",
    "@aws-sdk/client-sts": "^3.1175.0",
    "@aws-sdk/credential-providers": "^3.1175.0",
    "@clack/prompts": "^1.9.0",
    "@smithy/shared-ini-file-loader": "^4.7.2",
    "@smithy/types": "^4.20.0",
    "aws-cdk": "^2.1149.0",
    "aws-cdk-lib": "^2.278.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "vitest": "^5.1.1"
  }
}
