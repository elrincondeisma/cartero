{
  "name": "@cartero/server",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "demo": "tsx src/scripts/demo.ts",
    "admin": "tsx src/scripts/admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-ecs": "^3.1175.0",
    "@cartero/contracts": "workspace:*",
    "@cartero/core": "workspace:*",
    "@cartero/executor": "workspace:*",
    "@cartero/exporters": "workspace:*",
    "@cartero/importers": "workspace:*",
    "@cartero/mcp": "workspace:*",
    "@cartero/mock": "workspace:*",
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/static": "^10.1.12",
    "@fastify/websocket": "^11.3.7",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "bullmq": "^6.7.8",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fractional-indexing": "^4.0.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.6.1",
    "postgres": "^4.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11"
  }
}
