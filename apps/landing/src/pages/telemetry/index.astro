---
/**
 * Panel privado de la telemetría (usuario cualquiera, contraseña TELEMETRY_DASHBOARD_PASSWORD).
 * Las instalaciones «dev» se ocultan salvo con ?dev=1.
 */
import '../../styles.css'
import { dashboardAuthorized, sql } from '../../lib/telemetry'

export const prerender = false

if (!dashboardAuthorized(Astro.request.headers)) {
  return new Response('Acceso restringido', {
    status: 401,
    headers: { 'www-authenticate': 'Basic realm="Cartero telemetry", charset="UTF-8"', 'cache-control': 'no-store' },
  })
}
Astro.response.headers.set('cache-control', 'no-store')
Astro.response.headers.set('x-robots-tag', 'noindex, nofollow')

const showDev = Astro.url.searchParams.get('dev') === '1'
const notDev = showDev ? 'true' : `mode <> 'dev'`
const db = sql()
type Row = Record<string, any>
const q = (text: string, params: unknown[] = []) => db.query(text, params) as Promise<Row[]>

const [totals] = await q(`
  select count(*) filter (where last_seen > now() - interval '7 days')::int as active7,
         count(*) filter (where last_seen > now() - interval '30 days')::int as active30,
         count(*)::int as total,
         count(*) filter (where first_seen > now() - interval '30 days')::int as new30
  from telemetry_instances where ${notDev}`)

// Instancias activas (últimos 30 días): su último informe
const active = `from telemetry_instances where last_seen > now() - interval '30 days' and ${notDev}`
const [people] = await q(`
  select coalesce(sum((last_report->'size'->>'users')::int), 0)::int as users,
         coalesce(sum((last_report->'size'->>'activeUsers30d')::int), 0)::int as active30,
         coalesce(sum((last_report->'size'->>'activeUsers7d')::int), 0)::int as active7,
         coalesce(sum((last_report->'size'->>'collections')::int), 0)::int as collections,
         coalesce(sum((last_report->'size'->>'savedRequests')::int), 0)::int as requests,
         coalesce(sum((last_report->'size'->>'activeMonitors')::int), 0)::int as monitors
  ${active}`)
const group = (expr: string) => q(`select ${expr} as k, count(*)::int as n ${active} group by 1 order by 2 desc limit 15`)
const versions = await group('version')
const modes = await group('mode')
const countries = await group(`coalesce(country, '??')`)
const oses = await group(`(last_report->'install'->>'os') || '/' || (last_report->'install'->>'arch')`)
const configRows = await q(`
  select k, count(*) filter (where v = 'true')::int as yes, count(*)::int as n
  from (select key as k, value::text as v ${active.replace('from telemetry_instances', 'from telemetry_instances, jsonb_each(last_report->\'config\')')}) c
  group by k order by k`)

// Uso y errores: suma de los informes de los últimos 30 días
const reports30 = `from telemetry_reports r join telemetry_instances i on i.id = r.instance_id
  where r.received_at > now() - interval '30 days' and ${notDev.replace('mode', 'i.mode')}`
const usage = await q(`select key as k, sum(value::bigint)::bigint as n from (select (jsonb_each_text(r.payload->'usage')).* ${reports30}) u group by 1 order by 2 desc limit 40`)
const errors = await q(`select key as k, sum(value::bigint)::bigint as n from (select (jsonb_each_text(r.payload->'errors')).* ${reports30}) u group by 1 order by 2 desc limit 25`)
const weekly = await q(`
  select to_char(date_trunc('week', first_seen), 'YYYY-MM-DD') as k, count(*)::int as n
  from telemetry_instances where first_seen > now() - interval '12 weeks' and ${notDev} group by 1 order by 1`)

const fmt = (n: number | string) => Number(n).toLocaleString('es-ES')
const max = (rows: Row[]) => Math.max(1, ...rows.map((r) => Number(r.n)))
const sections: { title: string; rows: Row[] }[] = [
  { title: 'Versiones', rows: versions },
  { title: 'Cómo está instalado', rows: modes },
  { title: 'Países', rows: countries },
  { title: 'Sistema', rows: oses },
]
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Telemetría · Cartero</title>
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body class="bg-zinc-50 text-zinc-900">
    <main class="mx-auto max-w-6xl px-6 py-10">
      <header class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h1 class="text-3xl font-bold tracking-tight">Telemetría de Cartero</h1>
          <p class="mt-1 text-sm text-zinc-500">Instalaciones activas = han enviado un informe en los últimos 30 días. Uso y errores: suma de los informes de 30 días.</p>
        </div>
        <a href={showDev ? '/telemetry' : '/telemetry?dev=1'} class="text-sm text-brand-700 hover:underline">{showDev ? 'Ocultar instalaciones dev' : 'Incluir instalaciones dev'}</a>
      </header>

      <section class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {[
          ['Instalaciones activas (7 días)', totals.active7],
          ['Instalaciones activas (30 días)', totals.active30],
          ['Nuevas en 30 días', totals.new30],
          ['Instalaciones vistas en total', totals.total],
          ['Usuarios en instalaciones activas', people.users],
          ['Usuarios activos (30 días)', people.active30],
          ['Colecciones', people.collections],
          ['Peticiones guardadas', people.requests],
        ].map(([label, value]) => (
          <div class="rounded-xl border border-zinc-200 bg-white p-4">
            <div class="text-sm text-zinc-500">{label}</div>
            <div class="mt-1 text-3xl font-bold tabular-nums">{fmt(value as number)}</div>
          </div>
        ))}
      </section>

      <section class="mt-8 rounded-xl border border-zinc-200 bg-white p-5">
        <h2 class="font-semibold">Instalaciones nuevas por semana (12 semanas)</h2>
        {weekly.length === 0 ? <p class="mt-3 text-sm text-zinc-500">Aún no hay datos.</p> : (
          <div class="mt-4 flex h-40 items-end gap-2">
            {weekly.map((w) => (
              <div class="flex flex-1 flex-col items-center gap-1" title={`${w.k}: ${w.n}`}>
                <span class="text-xs tabular-nums text-zinc-600">{w.n}</span>
                <div class="w-full rounded-t bg-brand-600" style={`height:${Math.max(4, (Number(w.n) / max(weekly)) * 120)}px`} />
                <span class="text-[10px] text-zinc-400">{String(w.k).slice(5)}</span>
              </div>
            ))}
          </div>
        )}
      </section>

      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {sections.map((s) => (
          <section class="rounded-xl border border-zinc-200 bg-white p-5">
            <h2 class="font-semibold">{s.title}</h2>
            {s.rows.length === 0 ? <p class="mt-3 text-sm text-zinc-500">Aún no hay datos.</p> : (
              <ul class="mt-3 space-y-2">
                {s.rows.map((r) => (
                  <li class="text-sm">
                    <div class="flex justify-between gap-3"><span class="truncate font-mono text-xs">{r.k}</span><span class="tabular-nums">{fmt(r.n)}</span></div>
                    <div class="mt-1 h-1.5 rounded bg-zinc-100"><div class="h-1.5 rounded bg-brand-600" style={`width:${(Number(r.n) / max(s.rows)) * 100}%`} /></div>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))}

        <section class="rounded-xl border border-zinc-200 bg-white p-5">
          <h2 class="font-semibold">Configuración (instalaciones activas)</h2>
          {configRows.length === 0 ? <p class="mt-3 text-sm text-zinc-500">Aún no hay datos.</p> : (
            <ul class="mt-3 space-y-2">
              {configRows.map((r) => (
                <li class="text-sm">
                  <div class="flex justify-between gap-3"><span class="font-mono text-xs">{r.k}</span><span class="tabular-nums">{r.yes} / {r.n}</span></div>
                  <div class="mt-1 h-1.5 rounded bg-zinc-100"><div class="h-1.5 rounded bg-emerald-500" style={`width:${(Number(r.yes) / Math.max(1, Number(r.n))) * 100}%`} /></div>
                </li>
              ))}
            </ul>
          )}
        </section>

        <section class="rounded-xl border border-zinc-200 bg-white p-5">
          <h2 class="font-semibold">Uso (30 días)</h2>
          {usage.length === 0 ? <p class="mt-3 text-sm text-zinc-500">Aún no hay datos.</p> : (
            <ul class="mt-3 space-y-2">
              {usage.map((r) => (
                <li class="text-sm">
                  <div class="flex justify-between gap-3"><span class="truncate font-mono text-xs">{r.k}</span><span class="tabular-nums">{fmt(r.n)}</span></div>
                  <div class="mt-1 h-1.5 rounded bg-zinc-100"><div class="h-1.5 rounded bg-brand-600" style={`width:${(Number(r.n) / max(usage)) * 100}%`} /></div>
                </li>
              ))}
            </ul>
          )}
        </section>

        <section class="rounded-xl border border-zinc-200 bg-white p-5 md:col-span-2">
          <h2 class="font-semibold">Errores 5xx y fallos de actualización (30 días)</h2>
          {errors.length === 0 ? <p class="mt-3 text-sm text-zinc-500">Ninguno.</p> : (
            <table class="mt-3 w-full text-sm">
              <tbody>
                {errors.map((r) => (
                  <tr class="border-t border-zinc-100"><td class="py-1.5 font-mono text-xs">{r.k}</td><td class="py-1.5 text-right tabular-nums">{fmt(r.n)}</td></tr>
                ))}
              </tbody>
            </table>
          )}
        </section>
      </div>
    </main>
  </body>
</html>
