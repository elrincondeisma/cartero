# Clave para cifrar secretos y sesiones. Genera una con: openssl rand -base64 32
CARTERO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
# Contraseña de la base de datos
POSTGRES_PASSWORD=cambia-esto
# URL pública donde se sirve Cartero (para enlaces de invitación, OAuth y avisos)
PUBLIC_URL=http://localhost:3000
CARTERO_PORT=3000
# false = solo el primer usuario y los invitados pueden registrarse
ALLOW_REGISTRATION=true
# true = impide peticiones a redes privadas (recomendado si es pública en Internet)
BLOCK_PRIVATE_NETWORKS=false
# SMTP para invitaciones y avisos por email (opcional). Ej: smtps://usuario:clave@smtp.ejemplo.com:465
SMTP_URL=
SMTP_FROM=Cartero <no-reply@ejemplo.com>
