# ── Lo que el servidor necesita para arrancar ─────────────────────────────
# Clave para cifrar secretos y sesiones. Genera una con: openssl rand -base64 32
CARTERO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
# Contraseña de la base de datos
POSTGRES_PASSWORD=cambia-esto
CARTERO_PORT=3000
# Versión de Cartero: vacío usa la última publicada (stable) y se actualiza desde Administración.
# Pon una versión (0.2.0) para fijarla.
CARTERO_VERSION=
# Cuentas que pasan a admin de la instancia en cada arranque (para recuperar el acceso)
ADMIN_EMAILS=

# ── Valores iniciales ─────────────────────────────────────────────────────
# Al abrir Cartero por primera vez, el asistente de instalación te pide todo esto,
# y después se cambia en Administración. Estas variables solo dan el valor de partida.
PUBLIC_URL=http://localhost:3000
ALLOW_REGISTRATION=true
BLOCK_PRIVATE_NETWORKS=false
SMTP_URL=
SMTP_FROM=Cartero <no-reply@ejemplo.com>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
