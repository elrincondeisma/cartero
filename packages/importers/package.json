{
  "name": "@cartero/importers",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cartero/core": "workspace:*",
    "fflate": "^0.8.3",
    "openapi-to-postmanv2": "^6.4.4",
    "postman-collection-transformer": "^4.1.14",
    "shell-quote": "^1.12.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/shell-quote": "^1.7.5"
  }
}
