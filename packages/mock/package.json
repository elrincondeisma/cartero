{
  "name": "@cartero/mock",
  "version": "0.1.0",
  "description": "Lógica de los mock servers de Cartero (elegir ejemplo, responder desde el contrato). La usan el servidor y la app de escritorio",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cartero/contracts": "workspace:*",
    "@cartero/core": "workspace:*",
    "@faker-js/faker": "^10.6.0"
  }
}
