{
  "name": "@cartero/cli",
  "version": "0.1.0",
  "description": "CLI de Cartero: ejecuta colecciones (Postman, Insomnia, OpenAPI) en CI",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cartero": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "pnpm build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cartero/core": "workspace:*",
    "@cartero/executor": "workspace:*",
    "@cartero/importers": "workspace:*",
    "commander": "^15.1.0",
    "papaparse": "^5.7.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2"
  }
}
